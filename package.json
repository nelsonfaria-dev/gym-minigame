{
  "name": "gym-minigame",
  "version": "1.2.2",
  "description": "An eight-rep workout minigame for React.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nelsonfaria-dev/gym-minigame.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css"
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/components/GymExperience.d.ts",
    "dist/style.css",
    "dist/assets",
    "src/assets/fonts/OFL.txt",
    "LICENSE",
    "dist/leaderboard/types.d.ts",
    "dist/leaderboard/localLeaderboard.d.ts"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-icons": "^1.3.2"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@vitejs/plugin-react": "^5.1.0",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
